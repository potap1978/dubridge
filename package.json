{
  "name": "dubridge",
  "version": "0.1.0",
  "description": "Turn chat.deepseek.com web session into a local coding agent (CDP, sandboxed tools)",
  "type": "module",
  "bin": {
    "dubridge": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "prompts",
    "README.md",
    "LICENSE",
    ".env.example",
    "run.bat"
  ],
  "scripts": {
    "postinstall": "node dist/setup-cli.js || exit 0",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek",
    "agent",
    "cdp",
    "cli",
    "coding-assistant"
  ],
  "license": "MIT"
}
