{
  "name": "dubridge",
  "version": "0.1.0",
  "description": "Turn chat.deepseek.com web session into a local coding agent (CDP, sandboxed tools)",
  "type": "module",
  "bin": { "dubridge": "dist/index.js" },
  "main": "dist/index.js",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "puppeteer-core": "^23.0.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": { "node": ">=20" },
  "keywords": ["deepseek", "agent", "cdp", "cli", "coding-assistant"],
  "license": "MIT"
}
