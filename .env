# .env для dubridge — переопределяет дефолты.
# Системные переменные окружения имеют приоритет над этим файлом.
# Правки подхватываются после перезапуска сервиса.
# ---------- Песочница рабочей директории ----------
# Пусто = использовать рабочую директорию, из которой запущен сервис.
# Все файловые операции ограничены этой директорией; выход за её пределы отклоняется.
DUB_WORKSPACE_ROOT=./work
# ---------- Ритм замкнутого цикла (анти-бан) ----------
# Мин. интервал между запросами (мс). Было 3000 — увеличено.
DUB_SEND_MIN_INTERVAL_MS=6000
# Мин. пауза «ответ получен → отправить результат обратно» (мс). Было 2000 — увеличено.
DUB_REPLY_MIN_GAP_MS=4000
# Ожидание, пока поле ввода опустеет (мс).
DUB_FILL_WAIT_MS=6000
# Окно подтверждения начала генерации (мс).
DUB_STREAM_CONFIRM_MS=8000
# «Дополнить» встроенный список по умолчанию (или явно заданный выше), через запятую.
# Если задана только эта переменная — список по умолчанию продолжает действовать;
# подходит для случая «хочу добавить пару команд». Дубликаты дедуплицируются автоматически.
DUB_COMMAND_WHITELIST_EXTRA=
# ---------- Системный промпт ----------
# Путь к файлу промпта. Относительный путь ищется сначала от рабочей
# директории запуска, затем внутри пакета dubridge/prompts.
DUB_PROMPT_FILE=./prompts/deepseek-system-prompt.md
# ---------- SSH ----------
# Интерпретатор Python с пакетом paramiko. Пусто = искать python/py -3/python3 в PATH.
DUB_PYTHON=