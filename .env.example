# Скопируйте в .env и настройте под себя. Все переменные опциональны.

# ---------- CDP подключение ----------
# Хост и порт запущенного Chrome с --remote-debugging-port=9222
DUB_CDP_HOST=127.0.0.1
DUB_CDP_PORT=9222

# Если true — dubridge сам запустит Chrome (нужен CHROME_PATH)
# Если false — подключится к уже запущенному Chrome на DUB_CDP_PORT
DUB_LAUNCH_CHROME=true

# URL, который откроется при автозапуске Chrome
DUB_TARGET_URL=https://chat.deepseek.com/

# Путь к Chrome (если не находится автоматически)
DUB_CHROME_PATH=

# Профиль Chrome (по умолчанию ~/.dubridge/chrome-profile)
DUB_CHROME_PROFILE_DIR=

# ---------- Песочница ----------
# Рабочий каталог. Пусто = текущий каталог.
DUB_WORKSPACE_ROOT=

# Максимальный размер файла для чтения (байт)
DUB_MAX_FILE_BYTES=262144

# Максимальная длина ответа инструмента, отправляемого в чат (символов)
DUB_MAX_RESULT_CHARS=16384

# ---------- Команды ----------
# true = выполнять всё без подтверждения (ОПАСНО!)
DUB_AUTO_APPROVE_COMMANDS=false

# Дополнительные разрешённые команды (через запятую)
# Встроенный whitelist: npm run/test, git status/log/diff/show/branch, tsc, eslint, node, ls, dir, cat
DUB_COMMAND_WHITELIST_EXTRA=

# Таймаут команды (мс)
DUB_COMMAND_TIMEOUT_MS=120000

# ---------- Агент ----------
# true = пропустить отправку системного промпта (если вы его уже отправили вручную)
DUB_SKIP_SYSTEM_PROMPT=false

# Максимум итераций агента за сессию
DUB_MAX_ITERATIONS=50

# ---------- Логи ----------
# debug | info | warn | error
DUB_LOG_LEVEL=info
