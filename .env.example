# Скопируйте в .env и при необходимости измените. Все переменные необязательны;
# если не заданы — используются значения по умолчанию ниже.
# Также можно переопределить системными переменными окружения —
# они имеют приоритет над .env.

# ---------- Подключение по CDP ----------
# Хост, где слушает отладочный порт Chrome (не меняйте на 0.0.0.0 — отладочный порт это вход с высокими правами)
DUB_CDP_HOST=127.0.0.1
# Должен совпадать с --remote-debugging-port при запуске Chrome
DUB_CDP_PORT=9222
# Префикс URL целевой вкладки — чтобы найти DeepSeek среди нескольких вкладок
DUB_TARGET_URL_PREFIX=https://chat.deepseek.com
# Подстрока URL, по которой распознаётся «эндпоинт ответа»
DUB_API_PATH_PATTERN=/api/v0/chat/completion
# Путь, куда попадает тело потокового ответа: у кадров-приращений текста есть только v,
# без пути — поэтому путь задаётся здесь.
# -1 означает «последний фрагмент». При изменениях сайта правьте в первую очередь это.
DUB_CONTENT_PATH=response/fragments/-1/content

# ---------- Песочница рабочей директории ----------
# Пусто = использовать рабочую директорию, из которой запущен сервис.
# Все файловые операции ограничены этой директорией; выход за её пределы отклоняется.
DUB_WORKSPACE_ROOT=
# Учитывать ли .gitignore рабочей директории (включая вложенные) при поиске и листинге —
# чтобы не подметать в результаты такие артефакты, как public/, *.min.js и т.п.
# false = пропускать только встроенные «тяжёлые» директории (node_modules, .git и т.д.)
DUB_RESPECT_GITIGNORE=true
# true = режим только чтения: доступны только read_file / list_dir / search,
# запись файлов и выполнение команд целиком исключаются из набора инструментов
# (команды не могут доказать, что они «только на чтение», поэтому режима «только
# читающих команд» не предусмотрено). Подходит для сценария «пусть читает код, но не трогает».
DUB_READ_ONLY=false
# Максимальный размер одного файла для чтения в байтах; излишек обрезается и помечается truncated
DUB_MAX_FILE_BYTES=262144
# Максимум символов результата одного инструмента, возвращаемых в чат; излишек обрезается
DUB_MAX_RESULT_CHARS=16384
# Верхний предел буфера тела одного ответа (символы) — защита от аномального потока, разрывающего память
DUB_MAX_RESPONSE_CHARS=200000

# ---------- Выполнение команд ----------
# true = пропускать ручное подтверждение, выполнять всё автоматически (высокий риск, включать только при работе без оператора)
DUB_AUTO_APPROVE_COMMANDS=false
# Белый список команд, через запятую, сопоставление по префиксу (после префикса обязателен пробел или конец команды).
# Команды из белого списка выполняются автоматически; остальные требуют ввода y в терминале сервиса.
# Пусто = использовать встроенный консервативный список (рекомендуется). Здесь намеренно
# не продублирован встроенный список: как только вы задаёте эту переменную, она «целиком заменяет»
# встроенный список, а копия рано или поздно разойдётся с DEFAULT_COMMAND_WHITELIST в коде —
# и слепое копирование наоборот расширит права.
# Если нужно лишь дополнить список — используйте следующую переменную DUB_COMMAND_WHITELIST_EXTRA.
DUB_COMMAND_WHITELIST=
# «Дополнить» встроенный список по умолчанию (или явно заданный выше), через запятую.
# Если задана только эта переменная — список по умолчанию продолжает действовать;
# подходит для случая «хочу добавить пару команд». Дубликаты дедуплицируются автоматически.
DUB_COMMAND_WHITELIST_EXTRA=
# Максимальное время выполнения одной команды
DUB_COMMAND_TIMEOUT_MS=120000
# Максимум символов вывода команды; излишек обрезается
DUB_MAX_COMMAND_OUTPUT_CHARS=16384
# Рабочая директория для выполнения команд; пусто = совпадает с DUB_WORKSPACE_ROOT
DUB_COMMAND_CWD=

# ---------- Ритм замкнутого цикла ----------
# Минимальный интервал между текущим и следующим запросом (мс) — снижает риск срабатывания антифрода сайта
DUB_SEND_MIN_INTERVAL_MS=3000
# Максимальное время ожидания, пока поле ввода станет пустым, перед возвратом результата (мс).
# Пользователь может печатать в поле ввода — если оно непустое, подождать; при таймауте
# отложить возврат и показать ненавязчивое уведомление, чтобы пользователь нажал «Отправить повторно».
DUB_FILL_WAIT_MS=5000
# Минимальный интервал между «ответ получен → отправить результат обратно» (мс).
# Если выполнение инструментов заняло меньше — дождаться; если больше — отправлять сразу.
# Убирает ритм «ответил — тут же отправил». 0 = выключено.
DUB_REPLY_MIN_GAP_MS=2000
# Окно подтверждения «сайт начал генерацию» после возврата результата (мс).
# На стороне страницы «отправлено» определяется только по DOM: при перерисовке страницы
# или «проглатывании» синтетического события возникает ложный успех — «поле пустое, а сообщение
# в чат не попало». Если новый поток ответа не появился — об этом честно предупреждаем в логе
# (повторно не отправляем). 0 = отключить подтверждение.
DUB_STREAM_CONFIRM_MS=8000
# Таймаут ожидания одного полного ответа (мс)
DUB_RESPONSE_TIMEOUT_MS=180000
# Через сколько «подряд» идущих одинаковых вызовов инструментов считать, что топчемся на месте,
# и прервать текущий раунд. Считается только когда они идут подряд и между ними нет операций записи файлов:
# «изменил код — снова запустил ту же команду» не будет ложно распознано.
DUB_MAX_REPEAT_CALLS=3

# ---------- Автоотправка промпта ----------
# true = при запуске автоматически отправить промпт в DeepSeek.
# Срабатывает только в «пустом диалоге» (главная страница сайта); если уже внутри беседы — пропускается,
# чтобы не вставлять длинный промпт в идущий диалог.
# Принудительно отправить в текущий диалог: npm start -- --send-prompt
# Полностью отключить: DUB_AUTO_SEND_PROMPT=false или npm start -- --no-prompt
DUB_AUTO_SEND_PROMPT=true
# Путь к файлу промпта, разрешается относительно директории запуска сервиса;
# отправляется только текст между первой парой разделителей ---
DUB_PROMPT_FILE=prompts/deepseek-system-prompt.md
# Путь к файлу проектных соглашений (относительно директории запуска); его содержимое
# дописывается после промпта и отправляется вместе с ним.
# Намеренно сделан отдельным, не зависящим от языка файлом, а не разбором package.json —
# рабочая директория не обязательно является Node-проектом.
# Если файл не найден — молча пропускается, отправляется только общий промпт. Пусто = не прикреплять.
DUB_AGENT_FILE=agent.md

# ---------- Логи ----------
# debug | info | warn | error
DUB_LOG_LEVEL=info

# ---------- Помощь при запуске Chrome (только для скрипта launch-chrome) ----------
# Пусто = автоопределение пути установки Chrome в системе
DUB_CHROME_PATH=
# Пусто = использовать dubridge-chrome-profile во временной директории системы
DUB_CHROME_PROFILE_DIR=